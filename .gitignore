/target
/working
/working/
.DS_Store
*.jar
/fixtures/large/

# Python bytecode from the manifest tooling (scripts/*.py) — regenerable
__pycache__/
*.pyc

# Oracle harness scratch space (server runs, worlds, logs) — never committed
tools/rivet-oracle/work/
tools/rivet-capture/work/

# rivet-codegen scratch space (extracted bundler classpath, compiled helper) — regenerable
tools/rivet-codegen/.cache/

# rivet-codegen standalone workspace build output (own [workspace] root)
tools/rivet-codegen/target/

# Project .claude (workflows, settings) is repo content — override global ignore
!.claude/
# Agent worktree scratch (worktree-task preserves runs under .claude/worktrees/) —
# never scanned by cargo-machete and never tracked.
.claude/worktrees/
.claude/settings.local.json
